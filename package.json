{
  "name": "reels",
  "version": "1.0.0",
  "description": "Faceless vertical reels generator (Indonesian-first): Remotion + edge-tts/ElevenLabs/Piper (TTS) + whisper.cpp (captions)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "tts": "node scripts/tts.mjs",
    "tts:eleven": "node scripts/tts-eleven.mjs",
    "tts:edge": "node scripts/tts-edge.mjs",
    "captions": "node scripts/captions.mjs",
    "build:audio": "npm run tts && npm run captions",
    "build:audio:eleven": "npm run tts:eleven && npm run captions",
    "build:audio:edge": "npm run tts:edge && npm run captions",
    "studio": "remotion studio",
    "render": "remotion render Reel out/reel.mp4",
    "render:yt": "node scripts/render-yt.mjs",
    "all": "npm run build:audio && npm run render",
    "generate": "node scripts/generate-content.mjs",
    "clip": "node scripts/clip-pipeline.mjs",
    "web": "node scripts/server.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/install-whisper-cpp": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.539",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.0"
  }
}
