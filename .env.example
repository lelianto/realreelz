# Copy this file to ".env".

# --- Script generator (web app / npm run generate) ---
# Turns a prompt into a script + scenes. Get it from the Anthropic Console.
ANTHROPIC_API_KEY=
# Optional: override the model used by the generator.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Voice (TTS) ---
# Default engine is edge-tts (free, no key). Nothing needed here for it.
# Optional: pick the edge voice (list: npm run tts:edge list)
# EDGE_VOICE=id-ID-ArdiNeural      # or id-ID-GadisNeural
#
# The web app uses edge-tts by default. To use ElevenLabs instead:
#   TTS_ENGINE=eleven npm run web
# ElevenLabs is only needed if you choose it:
# ELEVENLABS_API_KEY=
# Optional: override the voice. Find ids with:  npm run tts:eleven list
# ELEVEN_VOICE_ID=
