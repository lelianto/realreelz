# Copy this file to ".env" and fill in your key.
# Get it from ElevenLabs: profile menu → "API Keys" → Create API Key.
ELEVENLABS_API_KEY=

# Optional: override the voice. Find ids with:  npm run tts:eleven list
# ELEVEN_VOICE_ID=

# For the web app (npm run web): turns a prompt into a script + scenes.
# Get it from the Anthropic Console → API Keys.
ANTHROPIC_API_KEY=
# Optional: override the model used by the generator.
# ANTHROPIC_MODEL=claude-sonnet-5-5
